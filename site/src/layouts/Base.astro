---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const defaultDescription = "An MCP server for analyzing UAP / Department of War declassified release material. Local-only inference via ollama. SQLite-backed corpus index with FTS5 retrieval. The analyst's tool for working through war.gov disclosures without burning chat context on raw media.";

const { title, description = defaultDescription } = Astro.props;
const titleSuffix = title === "uap-analyzer" ? "uap-analyzer" : `${title} — uap-analyzer`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titleSuffix}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f1115" />
  <meta property="og:title" content={titleSuffix} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://uap.mabus.ai/" />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || "https://uap.mabus.ai").toString()} />
</head>
<body class="bg-bg text-text min-h-screen flex flex-col">
  <Nav />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
