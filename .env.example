# Ollama backend (text + vision)
OLLAMA_HOST=http://192.168.6.56:11434
OLLAMA_TEXT_MODEL=qwq:32b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_TIMEOUT=300

# Where the corpus lives on disk inside the container
UAP_DATA_DIR=/srv/uap-data

# Where to store derived artifacts (frames, OCR text, SQLite index)
UAP_CACHE_DIR=/srv/uap-data/.cache

# HTTP server bind
UAP_HOST=0.0.0.0
UAP_PORT=3260

# Logging
LOG_LEVEL=INFO
