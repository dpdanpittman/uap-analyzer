# .env.example — copy to .env on the deploy host and edit values.
# IMPORTANT: .env is gitignored AND must be preserved across rsync deploys.
# Use `rsync --exclude=.env` (the deploy/zaphod-deploy.sh script does this).

# Host-side corpus location. The docker-compose default already points at
# the canonical zaphod location (/home/zaphod-beeblebox/uap-data) so a missing
# .env will still work — set this here only if you're deploying elsewhere.
UAP_HOST_DATA_DIR=/home/zaphod-beeblebox/uap-data

# Ollama daemon — host-network mode means localhost:11434 from the container's
# perspective reaches the host's ollama on zaphod.
OLLAMA_HOST=http://192.168.6.56:11434

# Models. Adjust if you've pulled different variants.
# Default vision model flipped from llama3.2-vision:11b to qwen2.5vl:7b in
# v0.4.3 after a Release_2 frame caused llama3.2-vision to (a) describe a
# clear targeting reticle + aircraft as "ocean, no objects" and (b) enter an
# infinite generation loop on a different frame. qwen2.5vl:7b handled the
# same material correctly on 9/9 frames. Keeping llama3.2-vision available
# in the whitelist for A/B; override here if you want to switch back.
OLLAMA_TEXT_MODEL=qwq:32b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_HUD_MODEL=qwen2.5vl:7b

# Inference timeout in seconds. qwen2.5vl:7b is fast (~10s/frame); qwq:32b is
# slow for long PDF summaries — raise this if you see timeouts.
OLLAMA_TIMEOUT=300

# faster-whisper config (audio transcription).
#   base.en   — 75MB,  fast, fine on clear English speech (default)
#   small.en  — 250MB, better on jargon / noisy clips
#   medium.en — 770MB, best CPU-feasible default for production
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# Server bind. host=0.0.0.0 so the MCP endpoint is reachable from LAN.
UAP_HOST=0.0.0.0
UAP_PORT=3260
LOG_LEVEL=INFO
